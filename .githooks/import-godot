#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
if [ ! -f "$root/project.godot" ]; then
    exit 0
fi

if command -v godot >/dev/null 2>&1; then
    engine=godot
elif command -v godot4 >/dev/null 2>&1; then
    engine=godot4
else
    printf '%s\n' 'Importação pendente: coloque o Godot no PATH e execute sh .githooks/import-godot.' >&2
    exit 1
fi

printf '%s\n' 'Atualizando recursos do Godot…'
"$engine" --headless --editor --path "$root" --import
