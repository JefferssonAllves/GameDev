config_version=5

[application]
config/name="Raízes do Brasil"
run/main_scene="res://raizes-do-brasil/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Campaign="*res://raizes-do-brasil/campaign.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"

[input]
move_left={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]}
jump={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]}
dash={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":1)]}
restart={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"device":-1,"button_index":3)]}
attack={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"device":-1,"button_index":2)]}
interact={"deadzone":0.25,"events":[Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"device":-1,"button_index":9)]}
