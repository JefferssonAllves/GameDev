[ext_resource type="Script" path="res://game/capoeirista.gd" id="1"]

[sub_resource type="Shader" id="SheetBackground"]
code = "shader_type canvas_item;

void fragment() {
	// O fundo escuro tem predominância de azul, ao contrário das regiões iluminadas do lutador.
	float background = step(COLOR.r, COLOR.b) * (1.0 - smoothstep(0.09, 0.21, COLOR.b));
	COLOR.a *= 1.0 - background;
}
"

[sub_resource type="ShaderMaterial" id="SheetMaterial"]
shader = SubResource("SheetBackground")

